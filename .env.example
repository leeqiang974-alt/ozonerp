# Store real Ozon credentials only in a local .env or secrets manager. Never commit them.
OZON_API_BASE_URL=https://api-seller.ozon.ru
APP_ENV=development
# 正式环境使用 PostgreSQL；自动化测试仍使用独立 SQLite。
DATABASE_URL=postgresql+psycopg://ozon_erp:replace-me@127.0.0.1:5432/ozon_erp
DEFAULT_LOCALE=zh-CN
DEFAULT_CURRENCY=CNY
# Generate once with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
ERP_CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-key

# LLM translation service (Chinese -> Russian product titles and descriptions).
# Default: DeepSeek, reading the local key file below. Do not put API keys here.
LLM_PROVIDER=deepseek
DEEPSEEK_API_KEY_FILE=D:\Desktop\api\deepseek.txt
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash
# To switch back after Volcano quota recovers: set LLM_PROVIDER=volcengine
# and provide the three VOLCENGINE_LLM_* values locally. The legacy LLM_* keys
# remain a compatibility fallback for the Volcano provider only.
VOLCENGINE_LLM_API_KEY=
VOLCENGINE_LLM_BASE_URL=
VOLCENGINE_LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
# Optional category understanding layer. The same configured LLM only ranks
# ambiguous Ozon candidates and never creates categories itself.
CATEGORY_AI_RERANK_ENABLED=true

# Yun Newton / 1688 OpenAPI: credentials are entered locally through the
# dedicated authorization endpoint and encrypted under .local-secrets/.
# Do not reuse or overwrite the OPEN1688_* JXHY credentials below.
YUNNIUDUN_REDIRECT_URI=https://auth.1688.com/auth/authCode.htm

# AI Ozon image-set workflow (Cangyuan/OpenAI compatible). Keep real keys local.
VISUAL_LLM_API_KEY=
VISUAL_LLM_BASE_URL=https://ai.cangyuansuanli.cn/v1
VISUAL_LLM_MODEL=gpt-5.6-terra
IMAGE_API_KEY=
IMAGE_BASE_URL=https://ai.cangyuansuanli.cn/v1
IMAGE_MODEL=gpt-image-2
GENERATED_IMAGE_PUBLIC_BASE=http://127.0.0.1:5500/generated/ai-images
CANGYUAN_API_KEY_FILE=D:\Desktop\api\cangyuanapi.txt
